# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your actual values.
# The `.env` file is in .gitignore — never commit real credentials.
#
# SETUP STEPS:
# 1. cp .env.example .env
# 2. Set DATABASE_URL to your PostgreSQL connection string
#    - Local:   postgresql://USER:PASSWORD@localhost:5432/downtothedetail
#    - Supabase: copy the "Session Mode" connection string from your project
# 3. Set AUTH_SECRET to a random 32+ character string
#    - Generate one: npx auth secret   (or openssl rand -base64 32)
# 4. Set AUTH_URL/NEXTAUTH_URL to the deployed site URL in production
# 5. Run: npx prisma migrate dev --name init
# 6. Run: npm run dev

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Auth.js secret — used to sign JWT session tokens.
# Must be at least 32 characters. Never share this value.
AUTH_SECRET="replace-this-with-a-long-random-string"

# The URL of your app (used by Auth.js for redirect URLs).
# In production, set both to the public HTTPS domain.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
